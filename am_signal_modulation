                     font=("Segoe UI", 13, "bold"), anchor="w").pack(fill="x")

            # Separator
            tk.Frame(card, bg=BORDER, height=1).pack(fill="x", pady=(6, 10))

            tk.Label(card, text=body, bg=CARD_BG, fg=TEXT_PRI,
                     font=("Consolas", 10), justify="left", anchor="w",
                     wraplength=900).pack(fill="x")

    # ── Status bar ─────────────────────────────────────────────────────────────

    def _build_status_bar(self):
        bar = tk.Frame(self, bg=CARD_BG, height=28)
        bar.pack(fill="x", side="bottom")
        bar.pack_propagate(False)
        tk.Label(bar, textvariable=self.var_status,
                 bg=CARD_BG, fg=TEXT_SEC,
                 font=("Segoe UI", 9), anchor="w",
                 padx=12).pack(side="left", fill="y")
        tk.Label(bar, text="AM Simulator  |  ECE Dept",
                 bg=CARD_BG, fg=TEXT_SEC,
                 font=("Segoe UI", 9), anchor="e",
                 padx=12).pack(side="right", fill="y")

    # =========================================================================
    #  Simulation logic
    # =========================================================================

    def _read_params(self):
        """
        Read and validate all parameter variables.
        Returns (fm, fc, Am, Ac, mu) or raises ValueError with a message.
        """
        fm  = float(self.var_fm.get())
        fc  = float(self.var_fc.get())
        Am  = float(self.var_Am.get())
        Ac  = float(self.var_Ac.get())
        mu  = float(self.var_mu.get())

        if fm <= 0:
            raise ValueError("Message frequency fm must be > 0 Hz.")
        if fc <= 0:
            raise ValueError("Carrier frequency fc must be > 0 Hz.")
        if fc <= fm:
            raise ValueError("Carrier frequency fc must be greater than fm.")
        if Am <= 0:
            raise ValueError("Message amplitude Am must be > 0.")
        if Ac <= 0:
            raise ValueError("Carrier amplitude Ac must be > 0.")
        if not (0.01 <= mu <= 1.0):
            raise ValueError("Modulation index μ must be between 0.01 and 1.0.")

        return fm, fc, Am, Ac, mu

    def run_simulation(self):
        """Main entry-point: compute signals and refresh all plots."""
        try:
            fm, fc, Am, Ac, mu = self._read_params()
        except ValueError as exc:
            messagebox.showerror("Input Error", str(exc))
            self.var_status.set(f"❌  Error: {exc}")
            return

        self.var_status.set("⚙  Computing signals …")
        self.update_idletasks()

        try:
            t   = self.engine.t
            msg = self.engine.message_signal(Am, fm)
            car = self.engine.carrier_signal(Ac, fc)
            am  = self.engine.am_signal(Am, Ac, fm, fc, mu)
            env = self.engine.envelope_detect(am, fc)
            rec = self.engine.recovered_message(env)

            # Cache for export
            self._last_signals = {
                "t": t, "message": msg, "carrier": car,
                "am": am, "envelope": env, "recovered": rec,
                "fm": fm, "fc": fc, "Am": Am, "Ac": Ac, "mu": mu,
            }

            # Update plots
            self._plot_modulation(t, msg, car, am, fm, fc, mu)
            self._plot_demodulation(t, am, env, rec, fm, fc)

            # Update analysis panel
            Pt, Pc, Ps = self.engine.compute_power(Ac, mu)
            BW = 2 * fm
            self.var_mu_disp.set(f"{mu:.4f}")
            self.var_Pt_disp.set(f"{Pt:.4f} W")
            self.var_Pc_disp.set(f"{Pc:.4f} W")
            self.var_Ps_disp.set(f"{Ps:.4f} W")
            self.var_BW_disp.set(f"{BW:.2f} Hz")

            eff = (Ps / Pt * 100) if Pt > 0 else 0
            self.var_status.set(
                f"✅  Simulation complete  |  fc = {fc:.0f} Hz  "
                f"|  fm = {fm:.0f} Hz  |  μ = {mu:.3f}  "
                f"|  Efficiency = {eff:.1f} %  |  BW = {BW:.0f} Hz"
            )

        except Exception as exc:
            messagebox.showerror("Simulation Error",
                                 f"An unexpected error occurred:\n\n{exc}\n\n"
                                 f"{traceback.format_exc()}")
            self.var_status.set(f"❌  Simulation failed: {exc}")

    # ── Plotting helpers ───────────────────────────────────────────────────────

    def _style_ax(self, ax, title, xlabel, ylabel):
        """Apply consistent engineering-grade axis styling."""
        ax.set_title(title, fontsize=11, fontweight="bold", pad=8)
        ax.set_xlabel(xlabel, fontsize=9)
        ax.set_ylabel(ylabel, fontsize=9)
        ax.grid(True, linestyle="--", alpha=0.4, color="#21262d")
        ax.tick_params(colors=TEXT_SEC, labelsize=8)
        for spine in ax.spines.values():
            spine.set_edgecolor(BORDER)

    def _plot_modulation(self, t, msg, car, am, fm, fc, mu):
        """Refresh the three modulation axes."""
        t_ms = t * 1e3          # convert to milliseconds for display

        # ── Message signal ───────────────────────────────────────────────────
        self.ax_msg.cla()
        self.ax_msg.plot(t_ms, msg, color=ACCENT2, linewidth=1.4,
                         label=f"m(t)  fm = {fm:.0f} Hz")
        self._style_ax(self.ax_msg,
                       "Message Signal  m(t) = Am·cos(2π·fm·t)",
                       "Time (ms)", "Amplitude (V)")
        self.ax_msg.legend(loc="upper right", fontsize=8)
        self.ax_msg.set_facecolor("#0d1117")

        # ── Carrier signal ───────────────────────────────────────────────────
        self.ax_car.cla()
        self.ax_car.plot(t_ms, car, color=ACCENT1, linewidth=1.2,
                         label=f"c(t)  fc = {fc:.0f} Hz")
        self._style_ax(self.ax_car,
                       "Carrier Signal  c(t) = Ac·cos(2π·fc·t)",
                       "Time (ms)", "Amplitude (V)")
        self.ax_car.legend(loc="upper right", fontsize=8)
        self.ax_car.set_facecolor("#0d1117")

        # ── AM modulated signal ──────────────────────────────────────────────
        self.ax_am.cla()
        self.ax_am.plot(t_ms, am, color=ACCENT3, linewidth=1.4,
                        label=f"s(t)  μ = {mu:.2f}")
        # Overlay envelope outline
        env_approx = np.max(np.abs(am)) * (1 + mu * np.cos(2*np.pi*fm*t)) / (1 + mu)
        self.ax_am.plot(t_ms, env_approx, "--",
                        color=ACCENT4, linewidth=1.0, alpha=0.7, label="Envelope ±")
        self.ax_am.plot(t_ms, -env_approx, "--",
                        color=ACCENT4, linewidth=1.0, alpha=0.7)
        self._style_ax(self.ax_am,
                       "AM Modulated Signal  s(t) = Ac·[1+μ·cos(2π·fm·t)]·cos(2π·fc·t)",
                       "Time (ms)", "Amplitude (V)")
        self.ax_am.legend(loc="upper right", fontsize=8)
        self.ax_am.set_facecolor("#0d1117")

        self.fig_mod.tight_layout(pad=1.5)
        self.canvas_mod.draw_idle()

    def _plot_demodulation(self, t, am, env, rec, fm, fc):
        """Refresh the three demodulation axes."""
        t_ms = t * 1e3

        # ── AM signal ─────────────────────────────────────────────────────────
        self.ax_am_d.cla()
        self.ax_am_d.plot(t_ms, am, color=ACCENT3, linewidth=1.3,
                          label="AM Signal  s(t)")
        self._style_ax(self.ax_am_d,
                       "Input AM Signal",
                       "Time (ms)", "Amplitude (V)")
        self.ax_am_d.legend(loc="upper right", fontsize=8)
        self.ax_am_d.set_facecolor("#0d1117")

        # ── Detected envelope ─────────────────────────────────────────────────
        self.ax_env.cla()
        self.ax_env.plot(t_ms, env, color=ACCENT1, linewidth=1.5,
                         label="Detected Envelope  e(t)")
        self.ax_env.fill_between(t_ms, env, alpha=0.12, color=ACCENT1)
        self._style_ax(self.ax_env,
                       "Detected Envelope  (Rectify + LPF)",
                       "Time (ms)", "Amplitude (V)")
        self.ax_env.legend(loc="upper right", fontsize=8)
        self.ax_env.set_facecolor("#0d1117")

        # ── Recovered message ─────────────────────────────────────────────────
        self.ax_rec.cla()
        self.ax_rec.plot(t_ms, rec, color=ACCENT4, linewidth=1.5,
                         label=f"Recovered m(t)  fm ≈ {fm:.0f} Hz")
        self.ax_rec.fill_between(t_ms, rec, alpha=0.10, color=ACCENT4)
        self._style_ax(self.ax_rec,
                       "Recovered Message Signal  (After DC Removal)",
                       "Time (ms)", "Amplitude (V)")
        self.ax_rec.legend(loc="upper right", fontsize=8)
        self.ax_rec.set_facecolor("#0d1117")

        self.fig_demod.tight_layout(pad=1.5)
        self.canvas_demod.draw_idle()

    # ── Slider callback ─────────────────────────────────────────────────────

    def _on_slider_change(self):
        """Debounced slider update – re-runs simulation after 150 ms."""
        try:
            self._slider_job
        except AttributeError:
            self._slider_job = None

        if self._slider_job is not None:
            self.after_cancel(self._slider_job)
        self._slider_job = self.after(150, self.run_simulation)

    # =========================================================================
    #  Actions: Reset / Export
    # =========================================================================

    def reset_defaults(self):
        """Restore all parameters to sensible defaults."""
        self.var_fm.set(500.0)
        self.var_fc.set(5000.0)
        self.var_Am.set(1.0)
        self.var_Ac.set(2.0)
        self.var_mu.set(0.5)
        self.var_status.set("↺  Parameters reset to defaults.")
        self.run_simulation()

    def export_png(self):
        """Save both modulation and demodulation figures as PNG files."""
        if not self._last_signals:
            messagebox.showwarning("No Data", "Run the simulation first.")
            return

        path = filedialog.asksaveasfilename(
            defaultextension=".png",
            filetypes=[("PNG Image", "*.png")],
            title="Save Modulation Plot As …",
            initialfile="am_modulation")

        if not path:
            return

        base, ext = os.path.splitext(path)
        try:
            self.fig_mod.savefig(path, dpi=150, bbox_inches="tight",
                                 facecolor=CARD_BG)
            demod_path = base + "_demodulation" + ext
            self.fig_demod.savefig(demod_path, dpi=150, bbox_inches="tight",
                                   facecolor=CARD_BG)
            messagebox.showinfo("Export Successful",
                                f"Plots saved:\n• {path}\n• {demod_path}")
            self.var_status.set(f"💾  Plots exported to {os.path.dirname(path)}")
        except Exception as exc:
            messagebox.showerror("Export Error", str(exc))

    def save_csv(self):
        """Export all signal arrays to a CSV file."""
        if not self._last_signals:
            messagebox.showwarning("No Data", "Run the simulation first.")
            return

        path = filedialog.asksaveasfilename(
            defaultextension=".csv",
            filetypes=[("CSV File", "*.csv")],
            title="Save Signal Data As …",
            initialfile="am_signals")

        if not path:
            return

        sigs = self._last_signals
        try:
            with open(path, "w", newline="") as f:
                writer = csv.writer(f)
                # Header with parameters
                writer.writerow(["# AM Simulator – Signal Data"])
                writer.writerow([f"# fm={sigs['fm']} Hz",
                                  f"fc={sigs['fc']} Hz",
                                  f"Am={sigs['Am']}",
                                  f"Ac={sigs['Ac']}",
                                  f"mu={sigs['mu']}"])
                writer.writerow([])
                writer.writerow(["Time (s)", "Message (V)", "Carrier (V)",
                                  "AM Signal (V)", "Envelope (V)",
                                  "Recovered (V)"])
                for i in range(len(sigs["t"])):
                    writer.writerow([
                        f"{sigs['t'][i]:.8f}",
                        f"{sigs['message'][i]:.6f}",
                        f"{sigs['carrier'][i]:.6f}",
                        f"{sigs['am'][i]:.6f}",
                        f"{sigs['envelope'][i]:.6f}",
                        f"{sigs['recovered'][i]:.6f}",
                    ])
            messagebox.showinfo("Export Successful",
                                f"Signal data saved to:\n{path}")
            self.var_status.set(f"📄  CSV saved to {path}")
        except Exception as exc:
            messagebox.showerror("CSV Error", str(exc))


