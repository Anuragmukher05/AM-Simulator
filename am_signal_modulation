class AMSimulator(tk.Tk):
    """
    Top-level Tkinter application for the AM Modulation & Demodulation
    Simulator.  Uses a Notebook widget to organise four tabs:
        1. Signal Parameters
        2. Modulation
        3. Demodulation
        4. Theory
    """

    APP_TITLE   = "AM Modulation & Demodulation Simulator"
    APP_VERSION = "v1.0"

    def __init__(self):
        super().__init__()
        self.title(f"{self.APP_TITLE}  {self.APP_VERSION}")
        self.configure(bg=DARK_BG)
        self.resizable(True, True)
        self.minsize(1100, 740)

        # ── Centre on screen ─────────────────────────────────────────────────
        self.update_idletasks()
        sw, sh = self.winfo_screenwidth(), self.winfo_screenheight()
        w, h   = 1280, 820
        self.geometry(f"{w}x{h}+{(sw-w)//2}+{(sh-h)//2}")

        # ── Core engine ──────────────────────────────────────────────────────
        self.engine = SignalEngine()

        # ── Tkinter variables (bound to widgets) ─────────────────────────────
        self._init_variables()

        # ── Style ─────────────────────────────────────────────────────────────
        self._configure_ttk_style()

        # ── Layout ───────────────────────────────────────────────────────────
        self._build_header()
        self._build_notebook()
        self._build_status_bar()

        # ── Initial simulation ────────────────────────────────────────────────
        self.after(200, self.run_simulation)

    # =========================================================================
    #  Initialisation helpers
    # =========================================================================

    def _init_variables(self):
        """Create all tkinter StringVar / DoubleVar controls."""
        self.var_fm     = tk.DoubleVar(value=500.0)     # Message frequency Hz
        self.var_fc     = tk.DoubleVar(value=5000.0)    # Carrier frequency Hz
        self.var_Am     = tk.DoubleVar(value=1.0)       # Message amplitude
        self.var_Ac     = tk.DoubleVar(value=2.0)       # Carrier amplitude
        self.var_mu     = tk.DoubleVar(value=0.5)       # Modulation index

        # Computed / display
        self.var_mu_disp   = tk.StringVar(value="—")
        self.var_Pt_disp   = tk.StringVar(value="—")
        self.var_Pc_disp   = tk.StringVar(value="—")
        self.var_Ps_disp   = tk.StringVar(value="—")
        self.var_BW_disp   = tk.StringVar(value="—")
        self.var_status    = tk.StringVar(value="Ready")

        # Cached signals for export
        self._last_signals: dict = {}

