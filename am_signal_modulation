    # ── Tab 1 helpers ─────────────────────────────────────────────────────────

    def _build_params_tab(self, parent):
        """Parameters form + sliders + analysis panel."""
        # Two-column layout: left = entry form, right = analysis
        left  = tk.Frame(parent, bg=DARK_BG)
        right = tk.Frame(parent, bg=DARK_BG)
        left.pack(side="left", fill="both", expand=False, padx=12, pady=12)
        right.pack(side="left", fill="both", expand=True, padx=12, pady=12)

        # ─ Entry form ────────────────────────────────────────────────────────
        ef = ttk.LabelFrame(left, text=" 🔧  Signal Parameters ", padding=14)
        ef.pack(fill="x", pady=(0, 12))

        rows = [
            ("Message Frequency  fm (Hz)",  self.var_fm,  1.0,    2000.0),
            ("Carrier Frequency  fc (Hz)",   self.var_fc,  500.0,  20000.0),
            ("Message Amplitude  Am",        self.var_Am,  0.1,    5.0),
            ("Carrier Amplitude  Ac",        self.var_Ac,  0.1,    5.0),
            ("Modulation Index  μ",          self.var_mu,  0.01,   1.0),
        ]
        self._entries = {}
        for r, (label, var, lo, hi) in enumerate(rows):
            tk.Label(ef, text=label, bg=CARD_BG, fg=TEXT_SEC,
                     font=("Segoe UI", 10), anchor="w").grid(
                         row=r, column=0, sticky="w", pady=5, padx=(0, 16))
            entry = tk.Entry(ef, textvariable=var, width=10,
                             bg=CARD_BG, fg=TEXT_PRI, insertbackground=TEXT_PRI,
                             relief="flat", font=("Consolas", 11),
                             highlightthickness=1, highlightcolor=ACCENT1,
                             highlightbackground=BORDER)
            entry.grid(row=r, column=1, sticky="ew", pady=5)
            self._entries[label] = (entry, lo, hi)

        ef.columnconfigure(1, weight=1)

        # ─ Interactive sliders ───────────────────────────────────────────────
        sf = ttk.LabelFrame(left, text=" 🎚  Interactive Sliders ", padding=14)
        sf.pack(fill="x", pady=(0, 12))

        slider_defs = [
            ("Carrier Freq fc (Hz)",  self.var_fc,  500,  20000, 100),
            ("Message Freq fm (Hz)",  self.var_fm,  1,    2000,  1),
            ("Modulation Index μ",    self.var_mu,  0.01, 1.0,   0.01),
        ]
        for label, var, lo, hi, res in slider_defs:
            row_f = tk.Frame(sf, bg=CARD_BG)
            row_f.pack(fill="x", pady=4)
            tk.Label(row_f, text=label, bg=CARD_BG, fg=TEXT_SEC,
                     font=("Segoe UI", 9), width=22, anchor="w").pack(side="left")
            sl = tk.Scale(row_f, variable=var, from_=lo, to=hi,
                          resolution=res, orient="horizontal",
                          bg=CARD_BG, fg=TEXT_PRI, troughcolor=BORDER,
                          highlightthickness=0, activebackground=ACCENT1,
                          sliderlength=16, length=240,
                          command=lambda _e: self._on_slider_change())
            sl.pack(side="left", padx=8)
            val_lbl = tk.Label(row_f, textvariable=var,
                               bg=CARD_BG, fg=ACCENT2,
                               font=("Consolas", 10), width=8)
            val_lbl.pack(side="left")

        # ─ Analysis panel ─────────────────────────────────────────────────────
        af = ttk.LabelFrame(right, text=" 📊  Signal Analysis ", padding=16)
        af.pack(fill="both", expand=True)

        metrics = [
            ("Modulation Index  μ",    self.var_mu_disp),
            ("Total Power  Pt  (W)",   self.var_Pt_disp),
            ("Carrier Power  Pc  (W)", self.var_Pc_disp),
            ("Sideband Power  Ps (W)", self.var_Ps_disp),
            ("Bandwidth  BW = 2·fm",   self.var_BW_disp),
        ]

        for i, (key, svar) in enumerate(metrics):
            row_f = tk.Frame(af, bg=CARD_BG, pady=4)
            row_f.pack(fill="x")
            tk.Label(row_f, text=key, bg=CARD_BG, fg=TEXT_SEC,
                     font=("Segoe UI", 10), anchor="w", width=28).pack(side="left")
            tk.Label(row_f, textvariable=svar, bg=CARD_BG, fg=ACCENT2,
                     font=("Consolas", 12, "bold"), anchor="e").pack(side="right", padx=8)
            # Separator line
            sep = tk.Frame(af, bg=BORDER, height=1)
            sep.pack(fill="x", pady=2)

        # Equation image
        eq_lbl = tk.Label(af,
            text="s(t) = Ac · [1 + μ·cos(2π·fm·t)] · cos(2π·fc·t)",
            bg=CARD_BG, fg=ACCENT4,
            font=("Consolas", 11, "italic"), pady=18)
        eq_lbl.pack(fill="x")

    # ── Tab 2 helpers ─────────────────────────────────────────────────────────

    def _build_modulation_tab(self, parent):
        """Three stacked plot canvases for message / carrier / AM signal."""
        self.fig_mod = Figure(figsize=(12, 7), tight_layout=True)
        self.ax_msg  = self.fig_mod.add_subplot(3, 1, 1)
        self.ax_car  = self.fig_mod.add_subplot(3, 1, 2)
        self.ax_am   = self.fig_mod.add_subplot(3, 1, 3)

        self.canvas_mod = FigureCanvasTkAgg(self.fig_mod, master=parent)
        self.canvas_mod.get_tk_widget().pack(fill="both", expand=True, padx=6, pady=6)

        toolbar_frame = tk.Frame(parent, bg=DARK_BG)
        toolbar_frame.pack(fill="x")
        NavigationToolbar2Tk(self.canvas_mod, toolbar_frame)

    # ── Tab 3 helpers ─────────────────────────────────────────────────────────

    def _build_demodulation_tab(self, parent):
        """Three stacked plot canvases for demodulation."""
        self.fig_demod  = Figure(figsize=(12, 7), tight_layout=True)
        self.ax_am_d    = self.fig_demod.add_subplot(3, 1, 1)
        self.ax_env     = self.fig_demod.add_subplot(3, 1, 2)
        self.ax_rec     = self.fig_demod.add_subplot(3, 1, 3)

        self.canvas_demod = FigureCanvasTkAgg(self.fig_demod, master=parent)
        self.canvas_demod.get_tk_widget().pack(fill="both", expand=True, padx=6, pady=6)

        toolbar_frame = tk.Frame(parent, bg=DARK_BG)
        toolbar_frame.pack(fill="x")
        NavigationToolbar2Tk(self.canvas_demod, toolbar_frame)

