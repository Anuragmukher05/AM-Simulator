# ─────────────────────────────────────────────────────────────────────────────
#  Signal Engine  (pure-NumPy maths, no GUI dependency)
# ─────────────────────────────────────────────────────────────────────────────
class SignalEngine:
    """
    Generates AM signals and performs envelope-detection demodulation.
    All computations are vectorised with NumPy for speed.
    """

    SAMPLE_RATE = 100_000          # samples per second (100 kHz)
    DURATION    = 0.05             # seconds of signal to display

    def __init__(self):
        self.t = np.linspace(0, self.DURATION,
                             int(self.SAMPLE_RATE * self.DURATION),
                             endpoint=False)

    # ── Signal generation ────────────────────────────────────────────────────

    def message_signal(self, Am: float, fm: float) -> np.ndarray:
        """m(t) = Am * cos(2π*fm*t)"""
        return Am * np.cos(2 * np.pi * fm * self.t)

    def carrier_signal(self, Ac: float, fc: float) -> np.ndarray:
        """c(t) = Ac * cos(2π*fc*t)"""
        return Ac * np.cos(2 * np.pi * fc * self.t)

    def am_signal(self, Am: float, Ac: float, fm: float,
                  fc: float, mu: float) -> np.ndarray:
        """
        s(t) = Ac * [1 + μ * cos(2π*fm*t)] * cos(2π*fc*t)
        Note: μ = Am/Ac for natural AM, but we expose μ directly as a control.
        """
        message = np.cos(2 * np.pi * fm * self.t)   # normalised message
        carrier = np.cos(2 * np.pi * fc * self.t)
        return Ac * (1 + mu * message) * carrier

    # ── Demodulation ─────────────────────────────────────────────────────────

    def envelope_detect(self, am_sig: np.ndarray,
                        fc: float) -> np.ndarray:
        """
        Full-wave rectification followed by a 2nd-order Butterworth low-pass
        filter.  Cut-off frequency is set to 10× the carrier frequency but
        clamped below Nyquist.
        """
        rectified = np.abs(am_sig)
        # Cut-off: just above the message band, well below carrier
        cutoff = min(fc * 0.5, self.SAMPLE_RATE * 0.4)
        cutoff = max(cutoff, 100)          # at least 100 Hz
        b, a = butter(4, cutoff / (self.SAMPLE_RATE / 2), btype="low")
        envelope = filtfilt(b, a, rectified)
        return envelope

    def recovered_message(self, envelope: np.ndarray) -> np.ndarray:
        """
        Remove DC offset from the detected envelope to recover the message.
        """
        return envelope - np.mean(envelope)

    # ── Power analysis ───────────────────────────────────────────────────────

    def compute_power(self, Ac: float, mu: float):
        """
        For standard AM:
            Pc  = Ac² / 2
            Ps  = (μ²/4) * Ac²     (each sideband = half of this)
            Pt  = Pc * (1 + μ²/2)
        """
        Pc  = (Ac ** 2) / 2.0
        Ps  = (mu ** 2 / 2.0) * Pc       # total sideband power
        Pt  = Pc + Ps
        return Pt, Pc, Ps


